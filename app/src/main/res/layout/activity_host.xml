<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#111317">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="조종 받기 (B)"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/txtIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="내 IP: …"
        android:textColor="#4FC3F7"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="#1C1F26"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="연결 PIN (A에게 알려주세요)"
        android:textColor="#AAB2BD" />
    <EditText
        android:id="@+id/editPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:textColor="#4FC3F7"
        android:textSize="20sp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/txtAccessibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="접근성 서비스: 확인 중"
        android:textColor="#AAB2BD"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="접근성 설정 열기 (원격 조종 허용)"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="화면 공유 시작" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFCC80"
        android:layout_marginTop="20dp" />

</LinearLayout>
