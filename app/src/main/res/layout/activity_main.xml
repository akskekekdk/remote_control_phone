<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#111317">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="원격 조종"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="연결 방식과 역할을 선택하세요"
        android:textColor="#AAB2BD"
        android:layout_marginBottom="24dp" />

    <RadioGroup
        android:id="@+id/radioMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp">
        <RadioButton
            android:id="@+id/radioWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="같은 와이파이"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:buttonTint="#4FC3F7"
            android:layout_marginEnd="20dp" />
        <RadioButton
            android:id="@+id/radioInternet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인터넷"
            android:textColor="#FFFFFF"
            android:buttonTint="#4FC3F7" />
    </RadioGroup>

    <Button
        android:id="@+id/btnController"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="조종하기 (A: 상대 화면 보기)"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnControlled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="조종 받기 (B: 내 화면 공유)" />

    <Button
        android:id="@+id/btnQuickConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingVertical="14dp"
        android:text="⚡ 최근 연결로 바로 연결"
        android:textStyle="bold"
        android:visibility="gone"
        android:backgroundTint="#4FC3F7"
        android:textColor="#0B0D10" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2E37"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="v1.1"
            android:textColor="#777" />

        <Button
            android:id="@+id/btnUpdate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="업데이트 확인" />
    </LinearLayout>

</LinearLayout>
