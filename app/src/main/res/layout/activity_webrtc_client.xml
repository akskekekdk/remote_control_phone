<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- 왼쪽 세로 버튼 바 (플랫 아이콘) -->
        <LinearLayout
            android:id="@+id/leftBar"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/leftbar_bg"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:paddingHorizontal="6dp">

            <LinearLayout android:id="@+id/btnRecents" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/navbtn_bg" android:layout_marginVertical="4dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_recents" android:contentDescription="최근앱" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="최근" android:textColor="#C7CBD1" android:textSize="10sp" android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnHome" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/navbtn_bg" android:layout_marginVertical="4dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" android:contentDescription="홈" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="홈" android:textColor="#C7CBD1" android:textSize="10sp" android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/navbtn_bg" android:layout_marginVertical="4dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_back" android:contentDescription="뒤로" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="뒤로" android:textColor="#C7CBD1" android:textSize="10sp" android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnVolUp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/navbtn_bg" android:layout_marginVertical="4dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_vol_up" android:contentDescription="볼륨 업" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="볼륨+" android:textColor="#C7CBD1" android:textSize="10sp" android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnVolDown" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/navbtn_bg" android:layout_marginVertical="4dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_vol_down" android:contentDescription="볼륨 다운" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="볼륨−" android:textColor="#C7CBD1" android:textSize="10sp" android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnQuality" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/navbtn_bg" android:layout_marginVertical="4dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_quality" android:contentDescription="화질" />
                <TextView android:id="@+id/txtQualityLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="표준" android:textColor="#C7CBD1" android:textSize="10sp" android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/rendererContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/renderer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- 진단 정보 (화질 아이콘 길게 누르면 켜짐) -->
    <TextView
        android:id="@+id/txtDebug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="68dp"
        android:layout_marginTop="4dp"
        android:background="#AA000000"
        android:padding="6dp"
        android:textColor="#9BFF9B"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:text=""
        android:visibility="gone" />

    <!-- 바로 연결(위젯/바로가기) 시 입력창 대신 보여주는 간단한 연결중 화면. 탭하면 설정창. -->
    <TextView
        android:id="@+id/txtConnecting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111317"
        android:gravity="center"
        android:text="연결 중…"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/overlayConnect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111317">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="조종하기 (A) · 인터넷"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginBottom="16dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="신호 서버 주소 (wss://…)" android:textColor="#AAB2BD" />
            <EditText android:id="@+id/editUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textUri" android:textColor="#FFFFFF" android:layout_marginBottom="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="방 코드 (B 화면에 표시됨)" android:textColor="#AAB2BD" />
            <EditText android:id="@+id/editCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:textColor="#4FC3F7" android:textSize="22sp" android:layout_marginBottom="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="연결 PIN (B가 정한 값)" android:textColor="#AAB2BD" />
            <EditText android:id="@+id/editPin" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:textColor="#4FC3F7" android:textSize="20sp" android:layout_marginBottom="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Cloudflare TURN (권장, 선택)" android:textColor="#777" />
            <EditText android:id="@+id/editCfKey" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Cloudflare Turn Key ID" android:textColorHint="#555" android:textColor="#FFFFFF" />
            <EditText android:id="@+id/editCfToken" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Cloudflare API Token" android:textColorHint="#555" android:textColor="#FFFFFF" android:layout_marginBottom="12dp" />

            <TextView android:id="@+id/txtUsage" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#AAB2BD" android:layout_marginBottom="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="직접 TURN (선택)" android:textColor="#777" />
            <EditText android:id="@+id/editTurnUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="turn:host:3478" android:textColorHint="#555" android:textColor="#FFFFFF" />
            <EditText android:id="@+id/editTurnUser" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="TURN 사용자" android:textColorHint="#555" android:textColor="#FFFFFF" />
            <EditText android:id="@+id/editTurnCred" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="TURN 비밀번호" android:textColorHint="#555" android:textColor="#FFFFFF" android:layout_marginBottom="16dp" />

            <CheckBox android:id="@+id/chkForceRelay" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="연결 안정 우선 (중계 강제 · 데이터 더 씀)" android:textColor="#C7CBD1"
                android:buttonTint="#4FC3F7" android:layout_marginBottom="8dp" />

            <Button android:id="@+id/btnQuick" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="지난 연결로 바로 접속" android:visibility="gone" android:layout_marginBottom="8dp" />

            <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="접속" />

            <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFCC80" android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
